# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: .env holds public defaults and is committed; .env*.local is for secrets
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# end-to-end tests
e2e/.bin
e2e/.results
e2e/.shots

# supabase cli
supabase/.temp
supabase/.branches
