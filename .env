# Public Supabase settings (the same project the Lovable site uses).
# Both values are meant to be public: NEXT_PUBLIC_* vars are compiled into the browser bundle,
# and the publishable key only allows what the database's row-level security permits.
# Put real secrets (never needed by this site) in .env.local, which git ignores.
NEXT_PUBLIC_SUPABASE_URL=https://ngoqiquizzslandsaema.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ge3Tkl9TRXXb2X2brdKTUA_532VQ5Mg
# Member login and everything behind it. Set to "on" after running
# supabase/migrations/*.sql on the project (see README, "Member portal").
NEXT_PUBLIC_MEMBER_PORTAL=off
