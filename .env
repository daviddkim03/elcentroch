# Public Supabase settings.
# Both values are meant to be public: NEXT_PUBLIC_* vars are compiled into the browser bundle,
# and the publishable key only allows what the database's row-level security permits.
# Put real secrets (never needed by this site) in .env.local, which git ignores.
NEXT_PUBLIC_SUPABASE_URL=https://pubqpyfnsucmkwsraoia.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Q1pB4QRWM7P2FSOmGfx0wg_o2Mf8-nw
# Member login and everything behind it. "on" needs the database from
# supabase/migrations (see README, "Member portal").
NEXT_PUBLIC_MEMBER_PORTAL=on
